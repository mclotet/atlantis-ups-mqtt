# NUT UPS name (as configured in nut-upsd)
UPS_NAME=ups
# Hostname or IP of the NUT server (use "nut-upsd" if running via this docker-compose)
UPS_HOST=nut-upsd
UPS_PORT=3493

# MQTT broker address
MQTT_HOST=localhost
MQTT_PORT=1883

# Polling frequency (seconds) when UPS is online
SAMPLE_RATE_ONLINE=60
# Polling frequency (seconds) when UPS is offline or data unavailable
SAMPLE_RATE_OFFLINE=10

# NUT UPS serial number (used by nut-upsd to identify the device)
UPS_SERIAL=
# NUT authentication
NUT_USER=
NUT_PASSWORD=

# USB device path for the UPS
UPS_USB_PATH=/dev/bus/usb/003

# ---------------------------------------------------------------------------
# Atlantis identity — used for MQTT topic construction and structured logging
# ---------------------------------------------------------------------------

# Physical/logical location (mqtt.md §1.2.1). "global" = rack/whole-house infrastructure
ATL_GROUP_ID=global

# Mission of the BRIDGED UPS (mqtt.md §1.2.2 / identity.md §3.2). "power" =
# electrical power distribution/metering. Not an ATL_* platform field: it's
# service-local, used to build the UPS's battery/status/availability topics.
MQTT_EDGE_NODE_ID=power

# This BRIDGE PROCESS's own identity (identity.md §2.2) — used for structured
# logging and the bridge's own availability topic/LWT. It is NOT the UPS's
# device_id (see UPS_DEVICE_ID below); the bridge is transport, never identity.
ATL_DEVICE_ID=ups-mqtt

# The bridged UPS's own identity (identity.md §2.2, PLAT-244) — used for the
# battery/status topics and the UPS's own NUT-driven availability topic. This
# is the device the UPS *is*, independent of whatever bridges it.
UPS_DEVICE_ID=apc-smartups750

# Service name used in structured log Resource attributes
ATL_SERVICE_NAME=ups-mqtt

# Logging environment: "development" = human-readable stdout, "pro"/"itg" = OTel JSON
ATL_ENV=pro

# Minimum log level: DEBUG, INFO, WARN, ERROR
ATL_LOG_LEVEL=INFO

# Max MQTT log messages per minute (0 = unlimited)
ATL_MQTT_LOG_MAX_PER_MINUTE=300

# Firmware/service version reported in the MQTT birth (availability) message
FW_VERSION=1.0.0
